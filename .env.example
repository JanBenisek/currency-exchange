# Currency Exchange CLI - API Keys
# Copy this file to .env and fill in your API keys
# The .env file is git-ignored for security

# Exchange Rates API Key (v6 - optional)
# Get your free key at: https://www.exchangerate-api.com/
# v4 (no key): 1,500 requests/month
# v6 (with key): 10,000 requests/month
# If not set, falls back to v4 free tier
EXCHANGERATE_API_KEY=your_exchangerate_api_key_here

# Fixer.io API Key
# Get your free key at: https://apilayer.com/fixer
# Free tier: 1,000 requests/month
FIXER_API_KEY=your_fixer_api_key_here

# CurrencyLayer API Key
# Get your free key at: https://currencylayer.com/product
# Free tier: 1,000 requests/month
CURRENCYLAYER_API_KEY=your_currencylayer_api_key_here

# Open Exchange Rates API Key
# Get your free key at: https://openexchangerates.org/signup
# Free tier: 1,000 requests/month
OPENEXCHANGERATES_API_KEY=your_openexchangerates_api_key_here
